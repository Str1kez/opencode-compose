# Repository opencode works on. Mounted read-write at the same absolute path.
WORKSPACE=/absolute/path/to/repo

# Basic auth password for the server (user: opencode). Generate: openssl rand -base64 32
OPENCODE_SERVER_PASSWORD=

# Compose project, one per repository: two repositories run side by side only under different
# names. The wizard derives it from WORKSPACE and keeps it on re-runs. Unset means `opencode`.
# COMPOSE_PROJECT_NAME=opencode

# Host port; the server is published on 127.0.0.1 only. The wizard offers a per-repository
# port derived from WORKSPACE, so a second repository doesn't collide on 4096.
OPENCODE_PORT=4096

# Hour (0-23, container TZ) of the daily update check.
OPENCODE_UPDATE_HOUR=4
TZ=Europe/Moscow

# Ports of host services the opencode config reaches as 127.0.0.1:<port> or
# localhost:<port> (local LLM proxy, MCP server). Comma-separated, e.g. 17321,8080.
HOST_LOOPBACK_PORTS=

# Base image (Debian-based, apt is required). Point it at a local image if Docker Hub is slow.
BASE_IMAGE=debian:trixie-slim

# Corporate apt mirror: host folder with *.sources / *.list / *.conf / *.crt. The wizard
# copies them into docker/apt/ (gitignored), the build applies them before apt-get.
# Empty means Debian's default sources. See docker/apt/README.md.
APT_CONFIG_SOURCE=

# Project toolchain installed into the image, space-separated apt packages.
# Python profile: build-essential plus the project's dev libraries (libpq-dev, libffi-dev).
EXTRA_APT_PACKAGES=

# 1 puts uv into the image (python profile), 0 leaves it out; nothing else is valid.
# Python itself comes from `uv sync`.
INSTALL_UV=0

# PyPI index pip installs uv from when INSTALL_UV=1 (https://pypi.org/simple by default).
# Point it at a corporate PyPI mirror where pypi.org is closed; https only, no login.
# The hashes in docker/uv-requirements.txt still pin the same uv.
UV_PIP_INDEX_URL=https://pypi.org/simple

# The container's own .venv is a volume per python project, mounted in
# docker-compose.override.yml: the wizard finds the projects and writes it, by hand see
# docker-compose.override.yml.example.

# Home volume (opencode login, session history, the downloaded binary). The wizard derives
# one per repository from WORKSPACE (opencode-home-<path>), because the agent can write to
# it and a shared one lets an agent in one repository plant code that runs in another.
# Without the wizard the default is the old shared volume opencode_opencode-home; set a
# per-repository name by hand. Keeping the shared one in the wizard's .env is an explicit
# opt-in with that cross-repository risk.
# HOME_VOLUME=opencode_opencode-home

# Docker engine the wizard detected (colima, orbstack, docker-desktop, other). The wizard
# compares it with the current docker context on re-runs; compose doesn't read it.
# DOCKER_ENGINE=orbstack

# Linux hosts: set to `id -u` / `id -g` so files in WORKSPACE keep your ownership.
# Docker Desktop and OrbStack on macOS map ownership themselves; leave as is.
OPENCODE_UID=1000
OPENCODE_GID=1000

# git push over ssh, written by the wizard together with the key and known_hosts mounts
# in docker-compose.override.yml. Empty means plain ssh, no key in the container.
# GIT_SSH_KEY=${HOME}/.ssh/id_deploy
# GIT_SSH_COMMAND=ssh -i /run/git-ssh/id -o IdentitiesOnly=yes -o BatchMode=yes -o UserKnownHostsFile=/run/git-ssh/known_hosts

# Read-only host configs. Defaults are shown; override only if yours live elsewhere.
# HOST_OPENCODE_CONFIG=${HOME}/.config/opencode
# HOST_GITCONFIG=${HOME}/.gitconfig
# Global agent skills, mounted by the wizard through docker-compose.override.yml.
# Asked only when ~/.agents is absent; empty means no skills mount.
# HOST_AGENTS_DIR=${HOME}/.agents
