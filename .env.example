# Repository opencode works on. Mounted read-write at the same absolute path.
WORKSPACE=/absolute/path/to/repo

# Basic auth password for the server (user: opencode). Generate: openssl rand -base64 32
OPENCODE_SERVER_PASSWORD=

# Host port; the server is published on 127.0.0.1 only.
OPENCODE_PORT=4096

# Hour (0-23, container TZ) of the daily update check.
OPENCODE_UPDATE_HOUR=4
TZ=Europe/Moscow

# Ports of host services the opencode config reaches as 127.0.0.1:<port> or
# localhost:<port> (local LLM proxy, MCP server). Comma-separated, e.g. 17321,8080.
HOST_LOOPBACK_PORTS=

# Base image (Debian-based, apt is required). Point it at a local image if Docker Hub is slow.
BASE_IMAGE=debian:trixie-slim

# Project toolchain installed into the image, space-separated apt packages.
EXTRA_APT_PACKAGES=

# Linux hosts: set to `id -u` / `id -g` so files in WORKSPACE keep your ownership.
# Docker Desktop and OrbStack on macOS map ownership themselves; leave as is.
OPENCODE_UID=1000
OPENCODE_GID=1000

# Read-only host configs. Defaults are shown; override only if yours live elsewhere.
# HOST_OPENCODE_CONFIG=${HOME}/.config/opencode
# HOST_GITCONFIG=${HOME}/.gitconfig
